---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navigation } from '../data/site';

export function getStaticPaths() {
  return navigation
    .filter((section) => section.path !== '/')
    .map((section) => ({
      params: { slug: section.path.replaceAll('/', '') },
      props: { section },
    }));
}

const { section } = Astro.props;
const sitePath = (path: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + path;
const aboutTopics = [
  { label: 'Personal Interests', path: '/about/interests/' },
  { label: 'Philosophy', path: '/about/philosophy/' },
];
---
<BaseLayout title={section.label}>
  <header class="page-heading">
    <h1>{section.label}</h1>
  </header>
  <section class="section" aria-label={section.label + ' content'}>
    {section.label === 'About' && (
      <div class="card-grid">
        {aboutTopics.map((topic) => (
          <a class="card card-link" href={sitePath(topic.path)}>
            <h2>{topic.label}</h2>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
