---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navigation } from '../data/site';

export function getStaticPaths() {
  return navigation
    .filter((section) => section.path !== '/')
    .map((section) => ({
      params: { slug: section.path.replaceAll('/', '') },
      props: { section },
    }));
}

const { section } = Astro.props;
---
<BaseLayout title={section.label}>
  <header class="page-heading">
    <h1>{section.label}</h1>
  </header>
  <section class="section" aria-label={section.label + ' content'}>
    <!-- Reserved for content agreed during the website interview. -->
  </section>
</BaseLayout>
