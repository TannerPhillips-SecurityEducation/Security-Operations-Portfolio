---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publications } from '../../data/showcase';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sorted = [...publications].sort((a,b) => {
  const ar = a.editions.find(e=>e.id===a.currentEdition);
  const br = b.editions.find(e=>e.id===b.currentEdition);
  return (br?.releasedAt || '').localeCompare(ar?.releasedAt || '');
});
---
<BaseLayout title="Publications">
  <header class="page-heading">
    <p class="eyebrow">Published Work</p>
    <h1>Publications</h1>
    <p class="lead">I collect deliberately published writing here, with the current edition, release history, and available ways to read or reference each work.</p>
  </header>
  <section class="section" aria-labelledby="released-heading">
    <h2 id="released-heading">Released Publications</h2>
    {sorted.length > 0 ? (
      <div class="card-grid">
        {sorted.map(pub => {
          const edition = pub.editions.find(e=>e.id===pub.currentEdition);
          return (
            <article class="card">
              <p class="status">{pub.kind} · {edition?.releasedAt}</p>
              <h3><a href={base + '/publications/' + pub.slug + '/'}>{pub.title}</a></h3>
              <p>{pub.summary}</p>
              <p class="knowledge-status">Current edition: {edition?.version}</p>
              <a class="text-link" href={base + '/publications/' + pub.slug + '/'}>Read and explore editions</a>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="curation-empty" role="status">
        <h3>No publications selected for this library yet</h3>
        <p>This collection lists only works I've intentionally released. Unpublished manuscripts, internal drafts, and concepts are not treated as publications.</p>
      </div>
    )}
  </section>
  <section class="section" aria-labelledby="editions-heading">
    <h2 id="editions-heading">Editions & References</h2>
    <p class="body-copy">Each publication can have a native reading experience, downloadable formats where provided, a suggested citation, and a transparent history of released editions. Only published versions are displayed.</p>
    <p><a href={base + '/knowledge/'}>Explore my separate Knowledge library</a></p>
  </section>
</BaseLayout>
