---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/showcase';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Projects">
  <header class="page-heading">
    <p class="eyebrow">Selected Work</p>
    <h1>Projects</h1>
    <p class="lead">I use this space for work I've deliberately chosen to showcase because there is a meaningful result that can be examined.</p>
  </header>
  <section class="section" aria-labelledby="curated-projects-heading">
    <h2 id="curated-projects-heading">Curated Projects</h2>
    {projects.length > 0 ? (
      <div class="card-grid">
        {projects.map(project => (
          <article class="card">
            <p class="status">{project.status === 'completed' ? 'Completed' : 'Demonstrable'} · {project.category}</p>
            <h3><a href={base + '/projects/' + project.slug + '/'}>{project.title}</a></h3>
            <p>{project.summary}</p>
            <a class="text-link" href={base + '/projects/' + project.slug + '/'}>Explore the case study</a>
          </article>
        ))}
      </div>
    ) : (
      <div class="curation-empty" role="status">
        <h3>No projects selected for the showcase yet</h3>
        <p>My project gallery is intentionally curated. Projects are added only after I choose to present them and have a tangible, publicly inspectable result to share.</p>
      </div>
    )}
  </section>
  <section class="section" aria-labelledby="project-approach-heading">
    <h2 id="project-approach-heading">How I Present My Work</h2>
    <p class="body-copy">Each selected project starts with a readable overview. For those who want to explore further, individual case studies can expand into its design, implementation, decisions, and evidence. An idea or unfinished concept is not represented as a completed project.</p>
    <p><a href={base + '/about/capabilities/'}>Explore my technical capabilities</a></p>
  </section>
</BaseLayout>
