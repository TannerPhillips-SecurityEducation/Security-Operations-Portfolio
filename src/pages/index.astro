---
import BaseLayout from '../layouts/BaseLayout.astro';
import TSPMark from '../components/TSPMark.astro';
import yamlSource from '../data/TSP.yaml?raw';
import { parseDocument, stringify } from 'yaml';
import { highlightYaml } from '../utils/highlightYaml';

const parsed = parseDocument(yamlSource, { uniqueKeys: true });
if (parsed.errors.length) throw new Error('TSP.yaml is invalid: ' + parsed.errors[0].message);
const profile = parsed.toJS();
const sitePath = (path: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + path;

const hints: Record<string, string> = {
  identity: 'The essentials',
  approach: 'How I engage with the world',
  interests: 'Curiosities and creative pursuits',
  philosophy: 'What guides my thinking',
  journey: 'Selected milestones',
  explore: 'A map to the rest of my website',
  connect: 'Public professional profiles',
};
const sections = Object.entries(profile).map(([key, value], index) => ({
  key,
  index,
  hint: hints[key] || 'Identity data',
  code: stringify({ [key]: value }, { lineWidth: 78 }),
}));
const pathways = [
  { key: 'about', label: 'About', number: '01', description: 'My journey, interests, perspective, and experience.' },
  { key: 'projects', label: 'Projects', number: '02', description: 'Curated creations and demonstrable work.' },
  { key: 'knowledge', label: 'Knowledge', number: '03', description: 'A native library of technical knowledge and connected documents.' },
  { key: 'publications', label: 'Publications', number: '04', description: 'Writing and reference works intentionally released.' },
  { key: 'education', label: 'Education', number: '05', description: 'My teaching philosophy, learning frameworks, and methods.' },
  { key: 'contact', label: 'Contact', number: '06', description: 'Connect through my approved professional profiles.' },
].map(item => ({ ...item, href: sitePath('/' + profile.explore[item.key]) }));
---
<BaseLayout title="Home" description="TSP.yaml: the personal website of Tanner S. Phillips, Security Educator, Engineer & Researcher. Thinker, Learner, Explorer & Creator.">
  <section class="home-hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker"><span class="signal-dot" aria-hidden="true"></span> PERSON / PRACTICE / POSSIBILITY</p>
      <div class="hero-signature"><TSPMark large /></div>
      <h1 id="hero-heading" class="hero-title"><span class="hero-title-primary">TSP</span><span class="hero-title-extension">.yaml</span></h1>
      <p class="hero-person-name">{profile.identity.name}</p>
      <p class="hero-headline">{profile.identity.headline}</p>
      <p class="hero-introduction">{profile.identity.introduction}</p>
      <div class="hero-approaches" aria-label="Personal approaches">
        {profile.approach.map((approach: string) => <span>{approach}</span>)}
      </div>
      <div class="hero-actions">
        <a href="#identity-document" class="primary-link">Explore my identity <span aria-hidden="true">↘</span></a>
        <a href={sitePath('/about/')} class="secondary-link">More about me <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-visual" aria-label="Abstract geometric visualization of connected ideas">
      <div class="visual-topline">
        <span><span class="visual-pulse" aria-hidden="true"></span> CONCEPTUAL GEOMETRY</span>
        <span>01 / ∞</span>
      </div>
      <div class="prism-stage" id="prism-stage">
        <svg class="prism-art" viewBox="0 0 660 630" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <radialGradient id="prismGlow">
              <stop offset="0" stop-color="#69E4DC" stop-opacity=".14"/>
              <stop offset=".5" stop-color="#B4A0FF" stop-opacity=".05"/>
              <stop offset="1" stop-color="#B4A0FF" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="prismEdge" x1="140" y1="138" x2="542" y2="510" gradientUnits="userSpaceOnUse">
              <stop stop-color="#B4A0FF" stop-opacity=".86"/>
              <stop offset=".54" stop-color="#69E4DC" stop-opacity=".9"/>
              <stop offset="1" stop-color="#FFBD7A" stop-opacity=".72"/>
            </linearGradient>
            <linearGradient id="prismFill" x1="285" y1="140" x2="391" y2="488" gradientUnits="userSpaceOnUse">
              <stop stop-color="#B4A0FF" stop-opacity=".1"/>
              <stop offset="1" stop-color="#69E4DC" stop-opacity=".025"/>
            </linearGradient>
          </defs>
          <circle cx="330" cy="310" r="280" fill="url(#prismGlow)"/>
          <g class="prism-grid" opacity=".19" stroke="#7B93AB" stroke-width=".6">
            {Array.from({length:13}, (_,i) => 54 + i*46).map(x=><path d={'M'+x+' 20V610'}/>)}
            {Array.from({length:13}, (_,i) => 37 + i*46).map(y=><path d={'M24 '+y+'H635'}/>)}
          </g>
          <circle cx="330" cy="310" r="232" stroke="#B4A0FF" stroke-opacity=".25" stroke-dasharray="2 11" stroke-width="1.6"/>
          <circle cx="330" cy="310" r="173" stroke="#69E4DC" stroke-opacity=".16"/>
          <g class="prism-orbit">
            <ellipse cx="330" cy="310" rx="255" ry="110" stroke="#69E4DC" stroke-opacity=".23" transform="rotate(-31 330 310)"/>
            <ellipse cx="330" cy="310" rx="251" ry="117" stroke="#B4A0FF" stroke-opacity=".17" transform="rotate(40 330 310)"/>
            <circle cx="115" cy="432" r="4" fill="#69E4DC"/>
            <circle cx="546" cy="185" r="5" fill="#B4A0FF"/>
          </g>
          <g class="prism-core">
            <path d="M329 106 488 207 528 408 330 526 132 408 172 207 329 106Z" fill="url(#prismFill)" stroke="url(#prismEdge)" stroke-width="1.25"/>
            <path d="M329 106V526 M172 207 528 408 M488 207 132 408" stroke="url(#prismEdge)" stroke-width="1.05" opacity=".62"/>
            <path d="M172 207 330 330 488 207 M132 408 330 330 528 408 M330 330 330 526" stroke="url(#prismEdge)" stroke-width="1.3" opacity=".72"/>
            <path d="M329 106 330 330 132 408 M329 106 330 330 528 408" stroke="#B4A0FF" stroke-opacity=".2"/>
            <path d="M172 207 330 526 488 207" stroke="#69E4DC" stroke-opacity=".19" stroke-width="1"/>
            <circle cx="330" cy="330" r="18" fill="#69E4DC" fill-opacity=".12" stroke="#69E4DC" stroke-opacity=".9"/>
            <circle cx="330" cy="330" r="5" fill="#69E4DC"/>
            <circle cx="329" cy="106" r="5" fill="#B4A0FF"/>
            <circle cx="172" cy="207" r="5" fill="#69E4DC"/>
            <circle cx="488" cy="207" r="5" fill="#FFBD7A"/>
            <circle cx="132" cy="408" r="5" fill="#B4A0FF"/>
            <circle cx="528" cy="408" r="5" fill="#69E4DC"/>
            <circle cx="330" cy="526" r="5" fill="#FFBD7A"/>
          </g>
          <g stroke="#69E4DC" stroke-opacity=".4" stroke-width=".8">
            <path d="M82 138h53 M82 138v53 M576 477h-53 M576 477v-53"/>
            <path d="M139 106h35 M139 106v35 M504 538h-35 M504 538v-35" opacity=".42"/>
          </g>
          <g class="prism-labels" fill="#9FB9C9" font-family="JetBrains Mono, monospace" font-size="12" letter-spacing="1.5">
            <text x="67" y="127">LOCUS_01</text>
            <text x="521" y="495">BOUNDARY</text>
            <text x="338" y="304">RELATION</text>
            <text x="73" y="565">OBSERVE</text>
            <text x="519" y="90">CREATE</text>
          </g>
        </svg>
      </div>
      <div class="visual-footer">
        <span>LOCUS <i aria-hidden="true">/</i> RELATION <i aria-hidden="true">/</i> BOUNDARY</span>
        <button id="motion-toggle" class="motion-toggle" type="button" aria-pressed="false" aria-controls="prism-stage">Enable motion</button>
      </div>
    </div>
  </section>

  <section id="identity-document" class="yaml-experience section" aria-labelledby="yaml-heading">
    <div class="section-intro">
      <div>
        <p class="eyebrow"><span class="section-number">01</span> THE LIVING INTRODUCTION</p>
        <h2 id="yaml-heading">A little about <em>who I am.</em></h2>
      </div>
      <p>Not another résumé. An explorable introduction written as real, machine-readable YAML, from a compact overview to the details behind it.</p>
    </div>
    <div class="yaml-window">
      <div class="yaml-window-bar">
        <div class="window-chrome" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="window-tab"><span class="file-diamond" aria-hidden="true">◆</span> TSP.yaml</div>
        <div class="window-meta">UTF-8 <span aria-hidden="true">·</span> YAML</div>
      </div>
      <div class="yaml-window-toolbar">
        <span class="yaml-explorer-label">PUBLIC IDENTITY <span class="yaml-inline-count">{sections.length} sections</span></span>
        <div class="yaml-controls">
          <button id="yaml-expand" type="button">Expand all</button>
          <button id="yaml-collapse" type="button">Collapse all</button>
          <button id="yaml-copy" type="button">Copy YAML</button>
          <a href={sitePath('/TSP.yaml')} target="_blank" rel="noopener noreferrer">Raw file ↗</a>
        </div>
      </div>
      <div class="yaml-sections">
        {sections.map(({key, hint, index, code}) => (
          <details class="yaml-fold" open={index < 2}>
            <summary>
              <span class="yaml-chevron" aria-hidden="true">›</span>
              <span class="yaml-summary-key">{key}<span class="yaml-punctuation">:</span></span>
              <span class="yaml-summary-hint">{hint}</span>
              <span class="yaml-fold-index">/{String(index + 1).padStart(2, '0')}</span>
            </summary>
            <pre class="yaml-code"><code set:html={highlightYaml(code)} /></pre>
          </details>
        ))}
      </div>
      <div class="yaml-window-bottom">
        <span>ONE SOURCE. MULTIPLE WAYS TO EXPLORE.</span>
        <a href={sitePath('/TSP.yaml')} download="TSP.yaml">Download source ↓</a>
      </div>
    </div>
    <pre id="yaml-copy-source" hidden>{yamlSource}</pre>
    <p class="yaml-copy-status" id="yaml-copy-status" role="status" aria-live="polite"></p>
  </section>

  <section class="home-pathways section" aria-labelledby="explore-heading">
    <div class="section-intro">
      <div>
        <p class="eyebrow"><span class="section-number">02</span> FIND YOUR PATH</p>
        <h2 id="explore-heading">More than <em>one discipline.</em></h2>
      </div>
      <p>My interests intersect, but each deserves its own space. Pick a direction and follow it as far as you like.</p>
    </div>
    <div class="pathways-grid">
      {pathways.map(path => (
        <a class="pathway-card" href={path.href}>
          <span class="pathway-number">{path.number} / 06</span>
          <span class="pathway-arrow" aria-hidden="true">↗</span>
          <h3>{path.label}</h3>
          <p>{path.description}</p>
          <span class="pathway-bottom" aria-hidden="true"></span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-closing section" aria-labelledby="closing-heading">
    <div class="closing-corner" aria-hidden="true"><span>✳</span></div>
    <div>
      <p class="eyebrow">ONE CONTINUING PROCESS</p>
      <h2 id="closing-heading">Think. Learn.<br/><span>Explore. Create.</span></h2>
      <p>I don't expect to know everything. I expect to keep learning, testing ideas, and finding new things worth understanding.</p>
      <a class="text-link" href={sitePath('/about/philosophy/')}>Explore my philosophy <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <script>
    const folds = Array.from(document.querySelectorAll<HTMLDetailsElement>('.yaml-fold'));
    document.querySelector<HTMLButtonElement>('#yaml-expand')?.addEventListener('click', () => {
      folds.forEach(fold => { fold.open = true; });
    });
    document.querySelector<HTMLButtonElement>('#yaml-collapse')?.addEventListener('click', () => {
      folds.forEach(fold => { fold.open = false; });
    });
    document.querySelector<HTMLButtonElement>('#yaml-copy')?.addEventListener('click', async () => {
      const text = document.querySelector<HTMLElement>('#yaml-copy-source')?.textContent || '';
      const status = document.querySelector<HTMLElement>('#yaml-copy-status');
      try {
        await navigator.clipboard.writeText(text);
        if (status) status.textContent = 'Complete YAML document copied to clipboard.';
      } catch {
        if (status) status.textContent = 'Clipboard access is unavailable. Use the Raw file link to copy the YAML.';
      }
    });
    const stage = document.querySelector<HTMLElement>('#prism-stage');
    const motion = document.querySelector<HTMLButtonElement>('#motion-toggle');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const updatePreference = () => {
      if (!motion || !stage) return;
      if (reduce.matches) {
        stage.classList.remove('motion-enabled');
        motion.disabled = true;
        motion.setAttribute('aria-pressed', 'false');
        motion.textContent = 'Reduced motion enabled';
      } else {
        motion.disabled = false;
        motion.textContent = stage.classList.contains('motion-enabled') ? 'Disable motion' : 'Enable motion';
        motion.setAttribute('aria-pressed', String(stage.classList.contains('motion-enabled')));
      }
    };
    motion?.addEventListener('click', () => {
      if (!stage || reduce.matches) return;
      stage.classList.toggle('motion-enabled');
      updatePreference();
    });
    reduce.addEventListener('change', updatePreference);
    updatePreference();
  </script>
</BaseLayout>
