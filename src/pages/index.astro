---
import BaseLayout from '../layouts/BaseLayout.astro';
import { identity, work } from '../data/site';
const sitePath = (path: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + path;
---
<BaseLayout title={identity.name} description={identity.summary}>
  <section class="hero">
    <p class="eyebrow">Security · Engineering · Education · Research</p>
    <h1>{identity.name}</h1>
    <p class="headline">{identity.headline}</p>
    <p class="lead">{identity.summary}</p>
    <div class="actions">
      <a class="primary-link" href={sitePath('/projects/')}>Explore projects</a>
      <a class="secondary-link" href={sitePath('/about/')}>About my work</a>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-heading">
    <div class="section-heading">
      <h2 id="featured-heading">Featured work</h2>
      <p>Ongoing projects and research, with status labels that distinguish developing work from published results.</p>
    </div>
    <div class="card-grid">
      {work.map((item) => (
        <article class="card">
          <p class="status">{item.status}</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          {'href' in item && item.href && <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">View source</a>}
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="explore-heading">
    <div class="section-heading">
      <h2 id="explore-heading">Explore by perspective</h2>
      <p>Multiple entry points into connected technical work.</p>
    </div>
    <div class="card-grid">
      <a class="card card-link" href={sitePath('/knowledge/')}><h3>Knowledge</h3><p>Concepts and relationships.</p></a>
      <a class="card card-link" href={sitePath('/publications/')}><h3>Publications</h3><p>Research and writing.</p></a>
      <a class="card card-link" href={sitePath('/education/')}><h3>Education</h3><p>Teaching and practical learning.</p></a>
      <a class="card card-link" href={sitePath('/contact/')}><h3>Contact</h3><p>Public profiles and collaboration.</p></a>
    </div>
  </section>
</BaseLayout>
