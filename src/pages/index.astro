---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navigation } from '../data/site';
const sitePath = (path: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + path;
const sections = navigation.filter((section) => section.path !== '/');
---
<BaseLayout title="Home">
  <header class="page-heading">
    <h1>Home</h1>
  </header>
  <section class="section" aria-label="Categories">
    <div class="card-grid">
      {sections.map((section) => (
        <a class="card card-link" href={sitePath(section.path)}>
          <h2>{section.label}</h2>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
