---
import '../styles/global.css';
import { identity, navigation } from '../data/site';

interface Props {
  title: string;
}
const { title } = Astro.props;
const sitePath = (path: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + path;
const pageTitle = title + ' | ' + identity.name;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={sitePath('/')}>{identity.name}</a>
        <nav aria-label="Primary navigation">
          <ul>
            {navigation.map((item) => (
              <li><a href={sitePath(item.path)} aria-current={Astro.url.pathname === sitePath(item.path) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {identity.name}</p>
      </footer>
    </div>
  </body>
</html>
